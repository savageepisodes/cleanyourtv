<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="104dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:id="@+id/cardRoot">

    <!-- Card Poster Frame -->
    <FrameLayout
        android:id="@+id/cardPosterFrame"
        android:layout_width="104dp"
        android:layout_height="150dp"
        android:background="@drawable/channel_card_bg"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/cardPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <View
            android:id="@+id/cardFocusBorder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/channel_card_focus_border"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Card Title -->
    <TextView
        android:id="@+id/cardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#E6FFFFFF"
        android:textSize="11sp"
        android:fontFamily="@string/font_medium"
        android:gravity="center_horizontal" />

    <!-- Card Subtitle (Year) -->
    <TextView
        android:id="@+id/cardSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#80FFFFFF"
        android:textSize="10sp"
        android:fontFamily="@string/font_light"
        android:gravity="center_horizontal" />

</LinearLayout>
